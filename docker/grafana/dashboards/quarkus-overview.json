{
  "id": null,
  "uid": "quarkus-overview",
  "title": "CoffeeShop - Technical Overview",
  "tags": [
    "logs",
    "ops",
    "quarkus",
    "slo",
    "technical",
    "traces"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "links": [
    {
      "title": "Management Dashboard",
      "url": "/d/coffeeshop-management",
      "type": "link",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Storage Dashboard",
      "url": "/d/observability-storage",
      "type": "link",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Compose Services",
      "url": "/d/compose-services-overview",
      "type": "link",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Kafka Topics",
      "url": "/d/kafka-topics-overview",
      "type": "link",
      "targetBlank": false,
      "keepTime": true,
      "includeVars": true
    },
    {
      "title": "Prometheus Alerts",
      "url": "http://localhost:9090/alerts",
      "type": "link",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Requests per Second",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"quarkus\"}[1m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "description": "Basislast des Services; ploetzliche Lastspruenge zuerst hier pruefen."
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 Latency",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"quarkus\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "description": "p95 End-to-End-Latenz der HTTP-Requests fuer User-wahrgenommene Antwortzeit."
    },
    {
      "type": "timeseries",
      "title": "HTTP Error Rate (4xx/5xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"quarkus\",status=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      },
      "description": "Zeitreihe der HTTP-Fehlerraten getrennt nach Statuscode-Klassen."
    },
    {
      "type": "timeseries",
      "title": "JVM Heap Used",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"quarkus\",area=\"heap\"})",
          "legendFormat": "heap",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "description": "Heap-Nutzung zur Erkennung von Memory-Druck und Leaks."
    },
    {
      "type": "timeseries",
      "title": "Process CPU Usage",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"quarkus\"} * 100",
          "legendFormat": "cpu %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "description": "CPU-Auslastung des Quarkus-Prozesses in Prozent."
    },
    {
      "type": "timeseries",
      "title": "Kitchen Processing p95",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(coffeeshop_kitchen_processing_seconds_bucket{job=\"quarkus\"}[5m])))",
          "legendFormat": "kitchen p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "description": "p95 Bearbeitungszeit der Kuechen-Pipeline als Business-Latenzsignal."
    },
    {
      "type": "timeseries",
      "title": "Kitchen Backpressure Orders",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "coffeeshop_kitchen_backpressure_orders{job=\"quarkus\"}",
          "legendFormat": "orders waiting",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      },
      "description": "Anzahl wartender Bestellungen; Kernindikator fuer Rueckstau."
    },
    {
      "type": "logs",
      "title": "Application Error/Warn Logs (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "expr": "{service=\"app\"} | logfmt | level=~\"$log_level\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 16,
        "h": 8
      },
      "description": "Warn-/Error-Logs mit Filter ueber die Variable Log Level fuer schnellere Suche. Nutzt die neue Logs-Visualisierung (v12.3) mit Controls, Highlighting und Detailansicht.",
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableInfiniteScrolling": true,
        "showControls": true,
        "syntaxHighlighting": true
      }
    },
    {
      "type": "timeseries",
      "title": "Span Duration p95 (Tempo)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"quarkus-observability\" } | quantile_over_time(duration, 0.95)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "description": "p95-Span-Dauer fuer Traces des Services zur Root-Cause-Eingrenzung."
    },
    {
      "type": "timeseries",
      "title": "Span Rate (Tempo)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"quarkus-observability\" } | rate()",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "description": "Span-Durchsatz, um Lastspitzen mit Latenzen zu korrelieren."
    },
    {
      "type": "stat",
      "title": "SLO: HTTP Error Ratio (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"quarkus\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"quarkus\"}[5m])), 0.001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 8,
        "h": 8
      },
      "description": "SLO-Wert fuer 5xx-Fehlerquote; Schwellenwerte zeigen Warn-/Kritischbereich."
    },
    {
      "type": "stat",
      "title": "SLO: HTTP p95 Latency (5m)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"quarkus\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 8,
        "y": 36,
        "w": 8,
        "h": 8
      },
      "description": "SLO-Wert fuer p95 HTTP-Latenz im 5m-Fenster."
    },
    {
      "type": "stat",
      "title": "SLO: Kitchen Backpressure",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "coffeeshop_kitchen_backpressure_orders{job=\"quarkus\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 8
              },
              {
                "color": "red",
                "value": 12
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 16,
        "y": 36,
        "w": 8,
        "h": 8
      },
      "description": "SLO-Indikator fuer Queue-Druck in der Kueche."
    },
    {
      "type": "text",
      "title": "Technischer Leitfaden",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "### Technischer Leitfaden\n- **Traffic und Fehler**: Starte mit HTTP Request Rate und Error Ratio.\n- **Laufzeitgesundheit**: JVM Heap und CPU zeigen Druck auf der Anwendung.\n- **Business-Engpass**: Steigende Kitchen Backpressure bei stabiler Last deutet auf Verarbeitungsengpässe hin.\n- **Tracing**: Vergleiche Tempo Span p95 und Span Rate zur Eingrenzung von Latenzspitzen."
      },
      "transparent": true,
      "description": "Runbook fuer technische Erstdiagnose und Priorisierung."
    },
    {
      "type": "piechart",
      "title": "HTTP Status Share (5m)",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"quarkus\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "description": "Verteilung der Antwortcodes zur schnellen Erkennung von Fehlerlast."
    },
    {
      "type": "gauge",
      "title": "HTTP Error Ratio Gauge (5m)",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"quarkus\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"quarkus\"}[5m])), 0.001)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Ampelansicht der aktuellen 5xx-Fehlerquote."
    },
    {
      "type": "bargauge",
      "title": "Top Endpoints by Request Rate (5m)",
      "gridPos": {
        "x": 18,
        "y": 48,
        "w": 6,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "topk(8, sum by (uri) (rate(http_server_requests_seconds_count{job=\"quarkus\",uri!~\"/q/.*\",uri=~\"$endpoint\"}[5m])))",
          "legendFormat": "{{uri}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "description": "Hot Endpoints nach Request-Rate; mit Endpoint-Variable fokussierbar."
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Technisches Dashboard fuer HTTP, JVM, Business-Pipeline und Tracing des CoffeeShop-Services.",
  "templating": {
    "list": [
      {
        "name": "endpoint",
        "type": "query",
        "label": "HTTP Endpoint",
        "hide": 0,
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(http_server_requests_seconds_count{job=\"quarkus\",uri!~\"/q/.*\"}, uri)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "log_level",
        "type": "custom",
        "label": "Log Level",
        "hide": 0,
        "query": "WARN,ERROR",
        "multi": true,
        "includeAll": true,
        "allValue": "WARN|ERROR",
        "current": {
          "selected": true,
          "text": "All",
          "value": "WARN|ERROR"
        }
      }
    ]
  }
}
