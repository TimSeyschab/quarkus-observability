{
  "id": null,
  "uid": "quarkus-overview",
  "title": "CoffeeShop - Technical Overview",
  "tags": [
    "quarkus",
    "observability",
    "technical"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 3,
  "refresh": "10s",
  "links": [
    {
      "title": "Management Dashboard",
      "url": "/d/coffeeshop-management",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Storage Dashboard",
      "url": "/d/observability-storage",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Prometheus Alerts",
      "url": "http://localhost:9090/alerts",
      "type": "link",
      "targetBlank": true
    }
  ],
  "panels": [
    {
      "type": "timeseries",
      "title": "HTTP Requests per Second",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"quarkus\"}[1m]))",
          "legendFormat": "rps",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP p95 Latency",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"quarkus\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "HTTP Error Rate (4xx/5xx)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"quarkus\",status=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "JVM Heap Used",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(jvm_memory_used_bytes{job=\"quarkus\",area=\"heap\"})",
          "legendFormat": "heap",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Process CPU Usage",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "process_cpu_usage{job=\"quarkus\"} * 100",
          "legendFormat": "cpu %",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Kitchen Processing p95",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(coffeeshop_kitchen_processing_seconds_bucket{job=\"quarkus\"}[5m])))",
          "legendFormat": "kitchen p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Kitchen Backpressure Orders",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "coffeeshop_kitchen_backpressure_orders{job=\"quarkus\"}",
          "legendFormat": "orders waiting",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Application Error/Warn Logs (Loki)",
      "datasource": "Loki",
      "targets": [
        {
          "expr": "{service=\"app\"} | logfmt | level=~\"WARN|ERROR\"",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 20,
        "w": 16,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Span Duration p95 (Tempo)",
      "datasource": "Tempo",
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"quarkus-observability\" } | quantile_over_time(duration, 0.95)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Span Rate (Tempo)",
      "datasource": "Tempo",
      "targets": [
        {
          "queryType": "traceql",
          "query": "{ resource.service.name = \"quarkus-observability\" } | rate()",
          "refId": "A"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "SLO: HTTP Error Ratio (5m)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"quarkus\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"quarkus\"}[5m])), 0.001)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "SLO: HTTP p95 Latency (5m)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"quarkus\"}[5m])))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1.0
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 8,
        "y": 36,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "SLO: Kitchen Backpressure",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "coffeeshop_kitchen_backpressure_orders{job=\"quarkus\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 8
              },
              {
                "color": "red",
                "value": 12
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "x": 16,
        "y": 36,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "text",
      "title": "Technischer Leitfaden",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "### Technischer Leitfaden\n- **Traffic und Fehler**: Starte mit HTTP Request Rate und Error Ratio.\n- **Laufzeitgesundheit**: JVM Heap und CPU zeigen Druck auf der Anwendung.\n- **Business-Engpass**: Steigende Kitchen Backpressure bei stabiler Last deutet auf Verarbeitungsengpässe hin.\n- **Tracing**: Vergleiche Tempo Span p95 und Span Rate zur Eingrenzung von Latenzspitzen."
      },
      "transparent": true
    },
    {
      "type": "piechart",
      "title": "HTTP Status Share (5m)",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"quarkus\"}[5m]))",
          "legendFormat": "{{status}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "type": "gauge",
      "title": "HTTP Error Ratio Gauge (5m)",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 6,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"quarkus\",status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"quarkus\"}[5m])), 0.001)",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.01
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Top Endpoints by Request Rate (5m)",
      "gridPos": {
        "x": 18,
        "y": 48,
        "w": 6,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "topk(8, sum by (uri) (rate(http_server_requests_seconds_count{job=\"quarkus\",uri!~\"/q/.*\"}[5m])))",
          "legendFormat": "{{uri}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    }
  ],
  "time": {
    "from": "now-1h",
