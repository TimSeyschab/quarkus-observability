          "expr": "topk(10, sum by (table) (mysql_info_schema_table_size{job=\"mariadb\",schema=\"quarkus\",component=~\"data_length|index_length\"}))",
          "legendFormat": "{{table}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
