      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(mysql_info_schema_table_size{job=\"mariadb\",schema=\"quarkus\",component=\"data_length\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 8,
        "y": 28,
        "w": 8,
        "h": 8
      }
    },
