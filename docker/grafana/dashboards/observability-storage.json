  "panels": [
    {
      "type": "stat",
      "title": "Prometheus TSDB Total Size",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "prometheus_tsdb_storage_blocks_bytes{job=\"prometheus\"} + prometheus_tsdb_head_chunks_storage_size_bytes{job=\"prometheus\"} + prometheus_tsdb_wal_storage_size_bytes{job=\"prometheus\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Prometheus WAL Size",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "prometheus_tsdb_wal_storage_size_bytes{job=\"prometheus\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "stat",
      "title": "Prometheus Head Series",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "prometheus_tsdb_head_series{job=\"prometheus\"}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
