{
  "id": null,
  "uid": "compose-services-overview",
  "title": "Compose Services Overview",
  "tags": [
    "observability",
    "docker",
    "services"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "links": [
    {
      "title": "Technical Dashboard",
      "url": "/d/quarkus-overview",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Management Dashboard",
      "url": "/d/coffeeshop-management",
      "type": "link",
      "targetBlank": false
    },
    {
      "title": "Storage Dashboard",
      "url": "/d/observability-storage",
      "type": "link",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "service",
        "type": "query",
        "label": "Service",
        "hide": 0,
        "datasource": "Loki",
        "query": "label_values({service=~\".+\"}, service)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": "All",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Running Services (Compose)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "count(count by (container_label_com_docker_compose_service) (container_last_seen{container_label_com_docker_compose_project=\"quarkus-observability\", container_label_com_docker_compose_service=~\"$service\"}))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "Running Containers",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "count(container_last_seen{container_label_com_docker_compose_project=\"quarkus-observability\", container_label_com_docker_compose_service=~\"$service\"})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 8,
        "y": 4,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "Mean Service Heartbeat Age",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(time() - max by (container_label_com_docker_compose_service) (container_last_seen{container_label_com_docker_compose_project=\"quarkus-observability\", container_label_com_docker_compose_service=~\"$service\"}))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 16,
        "y": 4,
        "w": 8,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "CPU Usage by Service",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"quarkus-observability\", image!=\"\", container_label_com_docker_compose_service=~\"$service\"}[5m]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Memory Working Set by Service",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_project=\"quarkus-observability\", image!=\"\", container_label_com_docker_compose_service=~\"$service\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 10,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Network Receive by Service",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_network_receive_bytes_total{container_label_com_docker_compose_project=\"quarkus-observability\", container_label_com_docker_compose_service=~\"$service\"}[5m]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Network Transmit by Service",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_network_transmit_bytes_total{container_label_com_docker_compose_project=\"quarkus-observability\", container_label_com_docker_compose_service=~\"$service\"}[5m]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "table",
      "title": "Service Heartbeat Age (s)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "time() - max by (container_label_com_docker_compose_service) (container_last_seen{container_label_com_docker_compose_project=\"quarkus-observability\", container_label_com_docker_compose_service=~\"$service\"})",
          "instant": true,
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "logs",
      "title": "Service Logs (Loki)",
      "datasource": "Loki",
      "targets": [
        {
          "expr": "{service=~\"$service\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      }
    },
    {
      "type": "text",
      "title": "Betriebsleitfaden",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "### Compose-Betriebsleitfaden\n- **Verfügbarkeit zuerst**: Prüfe laufende Services/Container und das Heartbeat-Alter.\n- **Ressourcendruck**: Vergleiche CPU- und Speicherverteilung pro Service.\n- **Verkehrsasymmetrie**: Network Receive vs. Transmit zeigt Producer-/Consumer-Muster.\n- **Fehlersuche**: Nutze Service-Tabelle und Logs für gezieltes Drill-down."
      },
      "transparent": true
    },
    {
      "type": "piechart",
      "title": "CPU Share by Service (5m)",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{container_label_com_docker_compose_project=\"quarkus-observability\", image!=\"\", container_label_com_docker_compose_service=~\"$service\"}[5m]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "type": "bargauge",
      "title": "Memory by Service (Current)",
      "gridPos": {
        "x": 12,
        "y": 38,
        "w": 12,
        "h": 8
      },
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (container_memory_working_set_bytes{container_label_com_docker_compose_project=\"quarkus-observability\", image!=\"\", container_label_com_docker_compose_service=~\"$service\"})",
          "legendFormat": "{{container_label_com_docker_compose_service}}",
          "refId": "A",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
